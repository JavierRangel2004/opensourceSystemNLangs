# Variables de entorno para el dashboard Wazuh.
# Este archivo es sólo de referencia. NO contiene secretos.
# Copia este archivo a .env (excluido del repo) y rellena con valores reales
# obtenidos por el procedimiento documentado en docs/CONFIGURATION.md.

# ---------------------------------------------------------------
# Receptor HTTP (loopback por defecto)
# ---------------------------------------------------------------
# Host de la escucha del receptor. Por defecto 127.0.0.1; cambiar
# requiere justificación operativa y autorización.
DASHBOARD_HOST=127.0.0.1
# Puerto del receptor. Por defecto 8787.
DASHBOARD_PORT=8787
# Token Bearer que el receptor exige en el encabezado Authorization.
# Si se omite, el dashboard genera uno runtime con SecureRandom y lo
# expone a los scripts internos (custom-dashboard, smoke). NO se imprime.
# El operador debe inyectarlo al Wazuh Manager por su canal seguro.
WEBHOOK_TOKEN=

# ---------------------------------------------------------------
# Modo de ejecución
# ---------------------------------------------------------------
# Valores admitidos: demo | live
# DASHBOARD_MODE=demo
# Ruta del recurso demo en el classpath; por defecto demo/alerts.json.
DASHBOARD_DEMO_RESOURCE=demo/alerts.json
# Ruta del PNG generado por el smoke headless.
DASHBOARD_OUTPUT=output/dashboard-demo.png

# ---------------------------------------------------------------
# API del Wazuh Manager (modo --live)
# ---------------------------------------------------------------
# URL del manager (incluye esquema y puerto). No incluir credenciales.
WAZUH_API_URL=https://wazuh-manager.example.org:55000
# Usuario con permisos de lectura sobre /agents.
WAZUH_API_USER=
# Contraseña del usuario. Inyectar por gestor de secretos.
WAZUH_API_PASSWORD=

# ---------------------------------------------------------------
# LDAP/AD institucional (modo --live, opcional)
# ---------------------------------------------------------------
# URL LDAPS del directorio. Verificar el certificado del servidor.
LDAP_URL=ldaps://ldap.example.org:636
# DN de servicio para búsquedas.
LDAP_BIND_DN=
# Contraseña del DN de servicio.
LDAP_BIND_PASSWORD=
# Base DN bajo el cual se buscan usuarios.
LDAP_BASE_DN=

# ---------------------------------------------------------------
# Variables consumidas por el script custom-dashboard (integración Wazuh)
# ---------------------------------------------------------------
# Token Bearer equivalente a WEBHOOK_TOKEN; necesario si el servicio
# del Manager no hereda la variable de la shell. Si tampoco está
# disponible, el script lee /etc/wazuh-dashboard/token (modo 0640
# root:wazuh) como último recurso. NO debe imprimirse en logs.
CUSTOM_DASHBOARD_TOKEN=
# Endpoint por defecto si el Manager no pasa hook_url en argv[3].
CUSTOM_DASHBOARD_ENDPOINT=http://127.0.0.1:8787/api/wazuh-events